# macOS
.DS_Store

# Configurações locais do Claude Code (paths específicos desta máquina)
.claude/settings.local.json

# Fichas reais de clientes — mantém só o template
clients/*.md
!clients/cliente-template.md

# Copies e entregas reais de clientes — mantém a estrutura de pastas (.gitkeep)
outputs/**/*.md
examples/**/*.md

# Registros de teste com dados reais de campanha/cliente
/TESTE-*.md

# Documentos de handoff entre sessões (contexto interno, com dados de cliente)
/HANDOFF-*.md

# Swipe file de imagens (grande, não essencial para o funcionamento do agent)
BASE DE CONHECIMENTO/Pinterest - Copywriting Techniques/

# Documentos internos de planejamento/arquitetura (não destinados ao repo público)
/GUIA-REPLICAR-ESTRUTURA-AGENT-IA.md
/PLANO-OTIMIZACAO-AGILIDADE.md
/PRD - Copywriting Agent.md
